# ══════════════════════════════════════════════════════════════════════════
# Codessy Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ══════════════════════════════════════════════════════════════════════════

# ── App ──────────────────────────────────────────────────────────────────
SECRET_KEY=
FERNET_KEY=
DATABASE_URL=
FRONTEND_URL=http://localhost:3000
API_BASE=http://localhost:8000
ADMIN_EMAILS=

# ── SMTP Provider (REQUIRED) ─────────────────────────────────────────────
# Must be exactly 'gmail' or 'namecheap'. Application will not start without this.
SMTP_METHOD=namecheap

# Gmail SMTP
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=465
GMAIL_SMTP_USERNAME=
GMAIL_SMTP_PASSWORD=
GMAIL_FROM_EMAIL=

# Namecheap SMTP
NAMECHEAP_SMTP_HOST=mail.privateemail.com
NAMECHEAP_SMTP_PORT=465
NAMECHEAP_SMTP_USERNAME=
NAMECHEAP_SMTP_PASSWORD=
NAMECHEAP_FROM_EMAIL=verification@codessy.site

# Shared
SMTP_FROM_NAME=Codessy

# ── OAuth (Google) ───────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── AI Providers ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# ── Razorpay ─────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── CORS (production) ────────────────────────────────────────────────────
# Comma-separated list of additional allowed origins (e.g. https://codessy.site)
ALLOWED_ORIGINS=

# ── Rate Limiting ────────────────────────────────────────────────────────
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW=300
RATE_LIMIT_RESET_ATTEMPTS=3
RATE_LIMIT_RESET_WINDOW=3600

# ── Features ─────────────────────────────────────────────────────────────
DRY_RUN=true
FREE_RATE_PER_HOUR=10
MAX_RATE_PER_HOUR=50
MANAGED_MODEL_NAME=claude-3.5

# ── Browser Agent ────────────────────────────────────────────────────────
PLAYWRIGHT_HEADLESS=false
REDIS_URL=redis://localhost:6379/0
JOB_AGENT_ENABLED=false

# ── Email Verification (Go server) ──────────────────────────────────────
EMAIL_VERIFIER_URL=http://localhost:8080

# ── n8n ──────────────────────────────────────────────────────────────────
N8N_WEBHOOK_SECRET=
